# Mẫu biến môi trường. Chép thành .env.local rồi điền giá trị. Khai báo các biến giống hệt trong
# Vercel → Settings → Environment Variables, rồi Redeploy.
# Để trống = dùng giá trị mặc định trong src/lib/site.ts. Muốn tắt hẳn một tính năng thì sửa trong site.ts.

# Tên miền chính của website (không có dấu / ở cuối). Để trống khi chạy ở máy.
# VD: NEXT_PUBLIC_SITE_URL=https://palwebagency.vn
NEXT_PUBLIC_SITE_URL=

# Link Google Apps Script để lưu form liên hệ vào Google Sheet (xem scripts/google-sheet-form.gs)
NEXT_PUBLIC_FORM_ENDPOINT=

# Google Search Console → Xác minh bằng "Thẻ HTML" → chép phần content="..."
# VD: NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=AbCdEf123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (dạng G-XXXXXXXXXX) — gắn trực tiếp trong code
NEXT_PUBLIC_GA_ID=

# Google Tag Manager (dạng GTM-XXXXXXX) — dùng cho Facebook Pixel, Google Ads… KHÔNG thêm thẻ GA4 trong GTM (đếm trùng)
NEXT_PUBLIC_GTM_ID=
